# Server configuration
PORT=8080
CLIENT_ID=your-google-client-id-here
CLIENT_SECRET=your-google--client-secret-here
# After visiting http://localhost:${PORT}/oauth/google once, paste the refresh token here:
GOOGLE_REFRESH_TOKEN=

# Optional: must match Google Cloud Console "Authorized redirect URIs" (default: http://localhost:8080/oauth/google/callback)
OAUTH_REDIRECT_URI=

# Set to "production" to disable dev logging middleware
NODE_ENV=development
